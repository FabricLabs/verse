# ============================================================================
# Vendored dependencies
# ============================================================================
# libwebsockets is installed via package manager (see install-deps.sh) and is
# not referenced by the Makefile; this local clone is redundant.
/src/libwebsockets/

# noise-c IS required by the build (provides $(SHA256_OBJ) and $(NOISE_LIB)).
# Excluded for now only because it is a nested git repo: adding it directly would
# create a broken gitlink. It is a pristine, unmodified clone of
# https://github.com/rweather/noise-c.git at cfe25410 (present on that remote),
# so nothing original is at risk here.
#
# DECISION REQUIRED before the first commit — see RELEASE_PLAN.md:
#   preferred: git submodule add https://github.com/rweather/noise-c.git src/noise-c
#              (then set `submodules: recursive` on actions/checkout in both workflows)
#   or:        remove src/noise-c/.git and vendor the source directly
# Until one is chosen, a fresh clone will NOT build.
/src/noise-c/

# Android native dependency clones (fetched separately)
android/third_party/
android/.gradle/
android/build/
android/app/build/
android/app/.cxx/

