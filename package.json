{
  "name": "@fabric/verse",
  "version": "1.0.0-rc.1",
  "description": "p2p game engine",
  "main": "types/verse.js",
  "scripts": {
    "build": "node scripts/build.js",
    "clean": "rm -f assets/verse.min.js assets/verse.min.map",
    "serve:assets": "http-server assets -c-1 -p 8080",
    "wasm": "make wasm",
    "compile": "gcc -o verse contracts/verse.c",
    "coverage": "c8 npm test",
    "test:ci": "mocha --timeout 15000 tests/encounter.unit.js tests/schemata.js tests/verse.core.js",
    "coverage:ci": "c8 npm run test:ci",
    "make:coverage:ci": "npm run coverage:ci && c8 report --reporter html",
    "report:coverage:ci": "mkdir -p reports && npm run make:coverage:ci && c8 report --reporter=text-lcov > reports/coverage.lcov",
    "demo": "npm run build && http-server assets",
    "docs": "npm run make:docs && http-server docs/",
    "local": "http-server .",
    "make:coverage": "npm run coverage && c8 report --reporter html",
    "make:docs": "jsdoc types README.md -c jsdoc.json -d docs",
    "report:coverage": "npm run make:coverage && c8 report --reporter=text-lcov > reports/coverage.lcov",
    "report:install": "rm -rf node_modules && mkdir -p reports && rm -f package-lock.json && echo \"$ npm i --allow-git=all\" > reports/install.log && npm i --allow-git=all >> reports/install.log 2>&1",
    "report:todo": "grep --exclude-dir=.git --exclude-dir=_book --exclude-dir=assets --exclude-dir=node_modules --exclude-dir=reports --exclude-dir=coverage --exclude-dir=docs --exclude-dir=noise-c --exclude-dir=libwebsockets -rEI \"TODO|FIXME\" . > reports/TODO.txt",
    "reports": "npm run report:install && npm run make:coverage && npm run report:todo",
    "start": "npm run clean && npm run build && node scripts/node.js",
    "test": "mocha tests",
    "release:verify": "bash scripts/release-verify.sh",
    "release:verify:native": "make release-check-native"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FabricLabs/verse.git"
  },
  "keywords": [
    "maki",
    "fabric",
    "p2p",
    "game",
    "engine",
    "cli",
    "terminal",
    "console",
    "chat"
  ],
  "author": "Eric Martindale",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/FabricLabs/verse/issues"
  },
  "homepage": "https://github.com/FabricLabs/verse#readme",
  "dependencies": {
    "@fabric/core": "FabricLabs/fabric#feature/v0.1.0-RC1",
    "@fabric/http": "FabricLabs/fabric-http#feature/v0.1.0-RC1",
    "@webcomponents/custom-elements": "1.6.0",
    "aframe": "^1.4.2",
    "canvas": "2.11.0",
    "fast-json-patch": "3.1.1",
    "is-my-json-valid": "2.20.6",
    "querystring-es3": "0.2.1"
  },
  "devDependencies": {
    "babel-loader": "8.2.5",
    "c8": "7.13.0",
    "http-server": "14.1.1",
    "jsdoc": "FabricLabs/jsdoc#fabric",
    "mocha": "10.2.0",
    "puppeteer": "20.1.1",
    "webpack-bundle-analyzer": "4.8.0"
  }
}
