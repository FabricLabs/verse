# VERSE: MAKEFILE
# This is the comprehensive, top-level Makefile for the entire VERSE project.
#
# Targets:
# - verse-client: Main game client with UI
# - verse: Core engine/server
# - proxy: HTTP proxy for server instances
# - starfighter: Space combat game
# - render-test: Test program for rendering
# - layer-viewer: Slice viewer for generated worlds
# - world-generation-benchmark: Benchmark suite for world generation
# - world-editor-renderer-benchmark: Benchmark for world editor rendering
# - wasm: Build WebAssembly viewer into assets/ (requires emscripten)
# - clang: Build verse-client with clang
# - clang-verse: Build verse with clang

# Compiler selection
CC ?= gcc
CLANG = clang

UNAME_S := $(shell uname -s 2>/dev/null || echo unknown)
NOISE_INCLUDES = -I$(CURDIR)/src/noise-c/include -I$(CURDIR)/src

# Optimization level. There was no -O flag anywhere in this file, which means every target built at
# clang's default of -O0: the tests, the profilers, and the verse-client binary a player runs.
#
# It is worth being concrete about the cost, because the number is large and it silently framed every
# performance decision made here. One 128^3 wilderness world takes 6428ms at -O0 and 1882ms at -O2,
# best of three runs each, and the two worlds are identical — same FNV-1a hash over all 2,097,152
# voxels, same solid count. So roughly two thirds of the world generation budget was the build, not
# the algorithm, and any measurement taken before this line existed overstates the cost of the code
# it was blaming by about 3.4x.
#
# Overridable, so a profile or a bisect can pin it: make OPTFLAGS=-O0. The debug target appends
# -g -O0 after this, and the last -O on the command line is the one clang honours, so it still wins.
OPTFLAGS ?= -O2

# Platform include/lib flags (Homebrew on macOS, pkg-config on Linux)
ifeq ($(UNAME_S),Darwin)
  BREW_PREFIX ?= $(shell brew --prefix 2>/dev/null || echo /opt/homebrew)
  COMMON_CFLAGS = -Wall -Wextra $(NOISE_INCLUDES) \
    -I$(BREW_PREFIX)/include \
    -I$(BREW_PREFIX)/include/libwebsockets \
    -I$(BREW_PREFIX)/include/jansson \
    -I$(BREW_PREFIX)/include/microhttpd \
    -I$(BREW_PREFIX)/include/SDL2
  LDFLAGS = -L$(BREW_PREFIX)/lib -lm -lwebsockets -ljansson -lmicrohttpd -lSDL2 -lSDL2_ttf -framework OpenGL
else ifeq ($(UNAME_S),Linux)
  PKG_CONFIG ?= pkg-config
  PC_CFLAGS := $(shell $(PKG_CONFIG) --cflags sdl2 SDL2_ttf libwebsockets jansson libmicrohttpd 2>/dev/null)
  PC_LIBS := $(shell $(PKG_CONFIG) --libs sdl2 SDL2_ttf libwebsockets jansson libmicrohttpd 2>/dev/null)
  COMMON_CFLAGS = -Wall -Wextra $(NOISE_INCLUDES) $(PC_CFLAGS) -pthread
  LDFLAGS = $(PC_LIBS) -lm -lGL -pthread
else
  # Best-effort fallback (e.g. BSD): adjust PREFIX as needed
  PREFIX ?= /usr/local
  COMMON_CFLAGS = -Wall -Wextra $(NOISE_INCLUDES) \
    -I$(PREFIX)/include -I$(PREFIX)/include/SDL2 -pthread
  LDFLAGS = -L$(PREFIX)/lib -lm -lwebsockets -ljansson -lmicrohttpd -lSDL2 -lSDL2_ttf -lGL -pthread
endif

# GCC-specific flags
GCC_CFLAGS = $(COMMON_CFLAGS)

# Clang-specific flags
CLANG_CFLAGS = $(COMMON_CFLAGS) -Weverything -Wno-disabled-macro-expansion -Wno-padded \
               -Wno-covered-switch-default -Wno-reserved-id-macro -Wno-documentation \
               -Wno-documentation-unknown-command -Wno-missing-variable-declarations \
               -Wno-missing-prototypes -Wno-unused-macros -Wno-c++98-compat \
               -Wno-c++98-compat-pedantic -Wno-vla -Wno-vla-extension

# Header dependencies, generated by the compiler rather than written by hand.
#
# The rules below name their headers explicitly, and some of them are wrong or incomplete — which
# does not fail the build, it produces a binary. A test object compiled against one layout of a
# struct, linked against library objects compiled against another, gives failures nowhere near the
# change that caused them: src/test_spawn_gravity.o listed no headers at all, so adding a field to
# GameState left it reading the wrong offsets and ten unrelated gravity assertions failed. -MMD
# writes what each object really included and the -include below makes make honour it, so an
# incomplete rule can no longer produce a stale object.
DEPFLAGS = -MMD -MP

# Default flags
CFLAGS = $(GCC_CFLAGS) $(OPTFLAGS) $(DEPFLAGS)
UI_CFLAGS = $(CFLAGS) -DUI_BUILD -DINTERFACE_MODE

# Emscripten config (for WebAssembly builds)
EMCC ?= emcc
EMCFLAGS = -O2 -sALLOW_MEMORY_GROWTH=1 -sASSERTIONS=1 -sFORCE_FILESYSTEM=1 -sUSE_SDL=2 -sUSE_SDL_TTF=2

# Noise library
NOISE_LIB = src/noise-c/src/protocol/libnoiseprotocol.a \
            src/noise-c/src/protobufs/libnoiseprotobufs.a \
            src/noise-c/src/keys/libnoisekeys.a
SHA256_OBJ = src/noise-c/src/crypto/sha2/sha256.o

# Anything linking src/world.o needs this entire set, not just world.o: world.c
# calls into bulk ops, universe placement, entropy sampling and constants, and
# universe.c calls back into the entropy generator. Declared once so link lines
# cannot drift; the set is closed (verified with nm -u).
# gpu_voxel_buffer belongs here despite the name: it is plain C with no SDL or GL, and world.c
# builds the occupancy bitfield through it for the renderer's face culling.
WORLD_CORE_OBJS = src/world.o src/world_bulk_ops.o src/constants.o \
                  src/universe.o src/entropy_field.o src/universe_coords.o src/universe_biome.o \
                  src/settlement.o src/household.o src/chronicle.o src/adventure_hooks.o src/world_entropy_generator.o src/gpu_voxel_buffer.o \
                  src/particle_effects.o src/fire_sim.o src/fluid_sim.o src/fluid_surface.o src/water_erosion.o src/water_table.o src/fog_volume.o \
                  src/fog_of_war.o src/shadow_world.o src/task_scheduler.o src/volcano.o src/lightning_path.o src/weather_storm.o \
                  src/mob_ai.o src/actor.o src/character.o src/item.o src/mob_loot.o src/currency.o src/poly_mesh.o src/voxel_shape.o $(SHA256_OBJ)

# shadow_world.o and task_scheduler.o are in the group because fog_of_war.o is: revealing fog samples
# the shadow cluster, and the cluster search runs on the task pool. Leaving them out meant all forty
# targets that link the world core had to know that, and the ones that did not simply failed to link.
#
# THREAD_OBJS and CLIENT_LIB_OBJS name them too, so any link line that combines those with this group
# is wrapped in $(sort ...), which is how make spells "remove duplicates". Without it the same object
# appears on the command line twice, and that is a duplicate symbol rather than a no-op.

# Same set as translation units, for the Emscripten build which compiles from source.
WORLD_CORE_SRCS = src/world.c src/world_bulk_ops.c src/constants.c \
                  src/universe.c src/entropy_field.c src/universe_coords.c src/universe_biome.c \
                  src/settlement.c src/household.c src/chronicle.c src/adventure_hooks.c src/world_entropy_generator.c src/gpu_voxel_buffer.c \
                  src/particle_effects.c src/fire_sim.c src/fluid_sim.c src/fluid_surface.c src/water_erosion.c src/water_table.c src/fog_volume.c \
                  src/fog_of_war.c src/shadow_world.c src/task_scheduler.c src/volcano.c src/lightning_path.c src/weather_storm.c \
                  src/mob_ai.c src/actor.c src/character.c src/item.c src/mob_loot.c src/currency.c src/poly_mesh.c src/voxel_shape.c \
                  src/noise-c/src/crypto/sha2/sha256.c

# Sub-voxel rendering: material template worlds plus the SDL atlas built from them. Anything that
# links isometric_renderer.o needs both, because the renderer resolves face UVs through the atlas
# and the atlas bakes from the templates. fp_renderer.o needs only material_worlds.o, because it
# rasterises on the CPU and samples the bakes directly. material_worlds.o alone is plain C with no
# SDL, which is what lets test_material_worlds run headlessly.
SUBVOXEL_OBJS = src/material_worlds.o src/material_atlas.o src/foliage_bend.o

# Nested voxel models for mobs. mob_models.o is plain C (headless tests); mob_sprite.o is the
# SDL isometric bake and only links into the client.
MOB_MODEL_OBJS = src/mob_models.o
MOB_SPRITE_OBJS = src/mob_sprite.o

# Threading: the worker pool plus the jobs built on it. Kept out of WORLD_CORE_OBJS so the
# headless tools and tests, which never start a pool, do not have to link it. Anything that
# submits work needs the whole set, because the jobs call into the pool.
THREAD_OBJS = src/task_scheduler.o src/world_gen_job.o src/world_physics_jobs.o
# world_physics_jobs calls voxel_fracture_step_falling; keep the object next to combat.
FRACTURE_OBJS = src/voxel_fracture.o src/voxel_combat.o src/voxel_debris_volume.o

# The shadow world cluster: one queryable coordinate space over the 3x3x3 of worlds around the
# player, and the shared search layer built on it. Plain C over borrowed World pointers, so it links
# into headless tools too, but it lives with the threading objects because GameState drives its
# residency from the physics tick and streams worlds in through the cell generation job.
SHADOW_OBJS = src/shadow_world.o
THREAD_SRCS = src/task_scheduler.c src/world_gen_job.c src/world_physics_jobs.c

# Core engine sources (main server/client); world core comes from WORLD_CORE_OBJS
CORE_SOURCES = src/main.c src/server.c src/engine.c src/client.c \
               src/verse.c src/player.c src/mud_telnet.c
CORE_OBJECTS = $(CORE_SOURCES:.c=.o)

# Game client sources (UI-based game); world core comes from WORLD_CORE_OBJS.
# Split so tests can link the client's guts against their own main.
CLIENT_LIB_OBJS = src/game_state.o src/storyline.o src/dialogue.o src/adventure_hooks.o src/game_log.o src/skill.o src/player_controls.o src/shop.o src/craft.o src/projectile.o src/debris.o src/voxel_combat.o src/voxel_fracture.o src/voxel_debris_volume.o src/spirit_sprite.o src/item_icon.o src/window.o src/fp_renderer.o src/voxel_shape.o src/gl_occupancy.o src/voxel_mesh.o src/octree.o \
                src/nav_aide.o src/gamepad.o \
                src/character.o src/actor.o src/world_transition.o src/world_spawn.o \
                src/input_manager.o src/engine.o \
                src/sequencer/melody_loader.o src/background_music.o \
                src/synthesizer/synthesizer.o src/songwriter/songwriter.o \
                src/isometric_renderer.o src/fog_volume.o src/console.o src/settings.o src/ui_sounds.o src/game_sfx.o \
                src/model_transformer.o src/greedy_mesh.o src/title_hum.o \
                src/wfc.o $(SUBVOXEL_OBJS) $(MOB_MODEL_OBJS) $(MOB_SPRITE_OBJS) $(THREAD_OBJS) $(SHADOW_OBJS)

CLIENT_SOURCES = src/verse_client.o $(CLIENT_LIB_OBJS)

# Proxy sources; world core comes from WORLD_CORE_OBJS
PROXY_SOURCES = src/proxy.c src/engine.c
PROXY_OBJECTS = $(PROXY_SOURCES:.c=.o)

# Build targets
all: verse-client starfighter entropy-test universe-entropy-simple-test universe-entropy-test wilderness-slice-analyzer
# Universe map generator (outputs BMP layers into assets/)
universe-map: src/universe_map_generator.o $(WORLD_CORE_OBJS)
	$(CC) $(UI_CFLAGS) -o universe-map src/universe_map_generator.o $(WORLD_CORE_OBJS) $(LDFLAGS)

# Universe reference renderer (top-down reference image generator)
universe-ref: src/universe_reference.o src/isometric_renderer.o src/fp_renderer.o src/gl_occupancy.o src/voxel_mesh.o src/octree.o src/cpu_renderer_optimized.o src/sprite_renderer.o $(SUBVOXEL_OBJS) $(MOB_MODEL_OBJS) $(MOB_SPRITE_OBJS) $(WORLD_CORE_OBJS)
	$(CC) $(UI_CFLAGS) -o universe-ref src/universe_reference.o src/isometric_renderer.o src/fp_renderer.o src/gl_occupancy.o src/voxel_mesh.o src/octree.o src/cpu_renderer_optimized.o src/sprite_renderer.o $(SUBVOXEL_OBJS) $(MOB_MODEL_OBJS) $(MOB_SPRITE_OBJS) $(WORLD_CORE_OBJS) $(LDFLAGS)

# Asset converter utility
asset-converter: src/asset_converter.o src/model_transformer.o src/wfc.o $(WORLD_CORE_OBJS)
	$(CC) $(CFLAGS) -o asset-converter src/asset_converter.o src/model_transformer.o src/wfc.o $(WORLD_CORE_OBJS) $(LDFLAGS)

# Main game client (the primary target)
verse-client: $(CLIENT_SOURCES) $(WORLD_CORE_OBJS)
	$(CC) $(UI_CFLAGS) -o verse-client $(sort $(CLIENT_SOURCES) $(WORLD_CORE_OBJS)) $(LDFLAGS)

# Debug build and run under LLDB
.PHONY: debug
debug: CFLAGS += -g -O0
debug: verse-client
	@echo "Launching LLDB for verse-client (break at main)..."
	@lldb -f ./verse-client -o "break set -n main" -o run

# Core engine/server (traditional version)
verse: $(CORE_OBJECTS) src/wfc.o $(NOISE_LIB) $(WORLD_CORE_OBJS)
	$(CC) $(CFLAGS) -o verse $(CORE_OBJECTS) src/wfc.o $(WORLD_CORE_OBJS) $(NOISE_LIB) $(LDFLAGS)

# Proxy server
proxy: $(PROXY_OBJECTS) src/wfc.o $(NOISE_LIB) $(WORLD_CORE_OBJS)
	$(CC) $(CFLAGS) -o proxy $(PROXY_OBJECTS) src/wfc.o $(WORLD_CORE_OBJS) $(NOISE_LIB) $(LDFLAGS)

# Render test program
render-test: src/render_test.o src/isometric_renderer.o src/wfc.o $(SUBVOXEL_OBJS) $(MOB_MODEL_OBJS) $(MOB_SPRITE_OBJS) $(WORLD_CORE_OBJS)
	$(CC) $(UI_CFLAGS) -o render-test src/render_test.o src/isometric_renderer.o src/wfc.o $(SUBVOXEL_OBJS) $(MOB_MODEL_OBJS) $(MOB_SPRITE_OBJS) $(WORLD_CORE_OBJS) $(LDFLAGS)

# Layer viewer to inspect generated worlds slice-by-slice (Z vertical)
layer-viewer: src/layer_viewer.o src/wfc.o $(WORLD_CORE_OBJS)
	$(CC) $(UI_CFLAGS) -o layer-viewer src/layer_viewer.o src/wfc.o $(WORLD_CORE_OBJS) $(LDFLAGS)

# World viewer for .vox imports
world-viewer: src/world_viewer.o src/model_transformer.o src/wfc.o $(WORLD_CORE_OBJS)
	$(CC) $(UI_CFLAGS) -o world-viewer src/world_viewer.o src/model_transformer.o src/wfc.o $(WORLD_CORE_OBJS) $(LDFLAGS)

# World editor (GPU-backed with optimized CPU fallback)
world-editor: src/world_editor.o src/isometric_renderer.o src/cpu_renderer_optimized.o src/unified_renderer.o src/model_transformer.o src/fluid_navier_stokes.o src/wfc.o src/fp_renderer.o src/gl_occupancy.o src/octree.o src/voxel_mesh.o src/gpu_physics.o src/ui_system.o src/world_editor_ui.o src/world_editor_input.o $(SUBVOXEL_OBJS) $(MOB_MODEL_OBJS) $(MOB_SPRITE_OBJS) src/spirit_sprite.o src/item_icon.o $(WORLD_CORE_OBJS)
	$(CC) $(UI_CFLAGS) -o world-editor src/world_editor.o src/isometric_renderer.o src/cpu_renderer_optimized.o src/unified_renderer.o src/model_transformer.o src/fluid_navier_stokes.o src/wfc.o src/fp_renderer.o src/gl_occupancy.o src/octree.o src/voxel_mesh.o src/gpu_physics.o src/ui_system.o src/world_editor_ui.o src/world_editor_input.o $(SUBVOXEL_OBJS) $(MOB_MODEL_OBJS) $(MOB_SPRITE_OBJS) src/spirit_sprite.o src/item_icon.o $(WORLD_CORE_OBJS) $(LDFLAGS)

# Naive window performance test
naive-window: src/naive_window.o src/isometric_renderer.o src/fp_renderer.o src/gl_occupancy.o src/voxel_mesh.o src/octree.o $(SUBVOXEL_OBJS) $(MOB_MODEL_OBJS) $(MOB_SPRITE_OBJS) $(WORLD_CORE_OBJS)
	$(CC) $(UI_CFLAGS) -o naive-window src/naive_window.o src/isometric_renderer.o src/fp_renderer.o src/gl_occupancy.o src/voxel_mesh.o src/octree.o $(SUBVOXEL_OBJS) $(MOB_MODEL_OBJS) $(MOB_SPRITE_OBJS) $(WORLD_CORE_OBJS) $(LDFLAGS)

# Greedy mesh utility
greedy-mesh: src/greedy_mesh_main.o src/greedy_mesh.o src/model_transformer.o src/wfc.o $(WORLD_CORE_OBJS)
	$(CC) $(CFLAGS) -o greedy-mesh src/greedy_mesh_main.o src/greedy_mesh.o src/model_transformer.o src/wfc.o $(WORLD_CORE_OBJS) $(LDFLAGS)

# CPU renderer optimization benchmark
cpu-benchmark: src/cpu_renderer_benchmark.o src/cpu_renderer_optimized.o src/isometric_renderer.o $(SUBVOXEL_OBJS) $(MOB_MODEL_OBJS) $(MOB_SPRITE_OBJS) $(WORLD_CORE_OBJS)
	$(CC) $(UI_CFLAGS) -o cpu-benchmark src/cpu_renderer_benchmark.o src/cpu_renderer_optimized.o src/isometric_renderer.o $(SUBVOXEL_OBJS) $(MOB_MODEL_OBJS) $(MOB_SPRITE_OBJS) $(WORLD_CORE_OBJS) $(LDFLAGS)

# CPU render phases test tool
cpu-render-phases: src/cpu_render_phases_test.o src/cpu_renderer_optimized.o src/isometric_renderer.o $(SUBVOXEL_OBJS) $(MOB_MODEL_OBJS) $(MOB_SPRITE_OBJS) $(WORLD_CORE_OBJS)
	$(CC) $(UI_CFLAGS) -o cpu-render-phases src/cpu_render_phases_test.o src/cpu_renderer_optimized.o src/isometric_renderer.o $(SUBVOXEL_OBJS) $(MOB_MODEL_OBJS) $(MOB_SPRITE_OBJS) $(WORLD_CORE_OBJS) $(LDFLAGS)

# Entropy field system test
entropy-test: src/entropy_test_minimal.o src/entropy_field.o src/universe_coords.o $(SHA256_OBJ)
	$(CC) $(UI_CFLAGS) -o entropy-test src/entropy_test_minimal.o src/entropy_field.o src/universe_coords.o $(SHA256_OBJ) $(LDFLAGS)

# Simple universe entropy field system test
universe-entropy-simple-test: src/universe_entropy_simple_test.o src/wfc.o $(WORLD_CORE_OBJS)
	$(CC) $(UI_CFLAGS) -o universe-entropy-simple-test src/universe_entropy_simple_test.o src/wfc.o $(WORLD_CORE_OBJS) $(LDFLAGS)

# Full universe entropy field system test
universe-entropy-test: src/universe_entropy_test.o src/wfc.o $(WORLD_CORE_OBJS)
	$(CC) $(UI_CFLAGS) -o universe-entropy-test src/universe_entropy_test.o src/wfc.o $(WORLD_CORE_OBJS) $(LDFLAGS)

# Wilderness slice analyzer for edge detection
wilderness-slice-analyzer: src/wilderness_slice_analyzer.o src/wfc.o $(WORLD_CORE_OBJS)
	$(CC) $(CFLAGS) -o wilderness-slice-analyzer src/wilderness_slice_analyzer.o src/wfc.o $(WORLD_CORE_OBJS) $(LDFLAGS)

# Clang builds
clang: CFLAGS = $(CLANG_CFLAGS)
clang: CC = $(CLANG)
clang: verse-client

clang-verse: CFLAGS = $(CLANG_CFLAGS)
clang-verse: CC = $(CLANG)
clang-verse: verse

# Object file rules
src/verse_client.o: src/verse_client.c
	$(CC) $(UI_CFLAGS) -c src/verse_client.c -o src/verse_client.o

