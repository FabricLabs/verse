	@echo "  clang         - Build verse-client with clang"
	@echo "  clang-verse   - Build verse with clang"
	@echo "  world-generation-benchmark - Build world generation benchmark suite"
	@echo "  world-analysis - Build world composition analysis program"
	@echo "  run-benchmark - Build and run world generation benchmarks"
