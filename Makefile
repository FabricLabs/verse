	rm -f src/*.o src/*/*.o src/*.d src/*/*.d verse verse-client proxy starfighter render-test layer-viewer world-generation-benchmark world-analysis test-bulk-ops test-universe-consistency test-refactored-worlds test-home-island-shape
	rm -f test-*
	cd src/noise-c && make clean

