# Sanitizer builds of the threading test. Kept as targets rather than notes so the race and
# memory checks can be re-run after any change to the pool or the jobs. Both need clang, and
# both are slow enough that they stay out of release-check-native; REPS raises the repeat count
# because a scheduling bug shows up intermittently, not on the first run.
# Sorted for the same reason the object groups are: THREAD_SRCS and WORLD_CORE_SRCS both name
# task_scheduler.c, and compiling one translation unit twice into a single binary is a duplicate
# symbol error rather than a no-op.
SANITIZE_SRCS = $(sort src/test_task_scheduler.c $(THREAD_SRCS) $(WORLD_CORE_SRCS) src/wfc.c)
SANITIZE_CFLAGS = -g -O1 -fno-omit-frame-pointer $(NOISE_INCLUDES)
REPS ?= 20

.PHONY: test-task-scheduler-tsan test-task-scheduler-asan sanitize-threads

build/tsan/test-task-scheduler: $(SANITIZE_SRCS)
	@mkdir -p build/tsan
	$(CLANG) -fsanitize=thread $(SANITIZE_CFLAGS) -o $@ $(SANITIZE_SRCS) -lm

build/asan/test-task-scheduler: $(SANITIZE_SRCS)
	@mkdir -p build/asan
	$(CLANG) -fsanitize=address,undefined $(SANITIZE_CFLAGS) -o $@ $(SANITIZE_SRCS) -lm

test-task-scheduler-tsan: build/tsan/test-task-scheduler
	@echo "=== ThreadSanitizer: $(REPS) runs ==="
	@for i in $$(seq 1 $(REPS)); do \
	  ./build/tsan/test-task-scheduler > build/tsan/run.log 2>&1 || { echo "run $$i failed:"; cat build/tsan/run.log; exit 1; }; \
	  grep -q 'ThreadSanitizer' build/tsan/run.log && { echo "run $$i reported a race:"; cat build/tsan/run.log; exit 1; }; \
	done; echo "=== no races in $(REPS) runs ==="

test-task-scheduler-asan: build/asan/test-task-scheduler
	@echo "=== AddressSanitizer + UBSan: $(REPS) runs ==="
	@for i in $$(seq 1 $(REPS)); do \
	  ./build/asan/test-task-scheduler > build/asan/run.log 2>&1 || { echo "run $$i failed:"; cat build/asan/run.log; exit 1; }; \
	done; echo "=== clean in $(REPS) runs ==="

sanitize-threads: test-task-scheduler-tsan test-task-scheduler-asan

run-universe-generate: universe-generate-gameworld
	./universe-generate-gameworld --radius 1

# -------------------------
# Android builds via Gradle
# -------------------------

.PHONY: android-debug android-release

android-debug:
	cd android && ./gradlew assembleDebug | cat
	@echo "APK output: android/app/build/outputs/apk/debug/app-debug.apk"

android-release:
	cd android && ./gradlew assembleRelease | cat
	@echo "APK output: android/app/build/outputs/apk/release/app-release-unsigned.apk"
