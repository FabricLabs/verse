# World generation profiler. Built as its own object set with -DWORLD_GEN_PROFILE so the
# instrumentation exists only here; every other target compiles the same sources with the
# macros expanded to nothing.
PROFILE_DIR = build/profile
PROFILE_SRCS = $(WORLD_CORE_SRCS) src/wfc.c src/world_gen_profile.c src/world_generation_profile.c
PROFILE_OBJS = $(patsubst %.c,$(PROFILE_DIR)/%.o,$(PROFILE_SRCS))

$(PROFILE_DIR)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -DWORLD_GEN_PROFILE -c -o $@ $<

# What a new game costs through the real job path: the startup worlds the loading screen waits for,
# and the background ring generated right after. Keeping this a build target rather than a throwaway
# script is what makes the ring's cost visible when someone changes its radius.
world-gen-startup-profile: src/world_gen_startup_profile.o src/world_gen_job.o src/wfc.o \
                           $(WORLD_CORE_OBJS)
	$(CC) $(CFLAGS) -o world-gen-startup-profile $(sort src/world_gen_startup_profile.o \
	  src/world_gen_job.o src/wfc.o $(WORLD_CORE_OBJS)) -lm

src/world_gen_startup_profile.o: src/world_gen_startup_profile.c
	$(CC) $(CFLAGS) -c src/world_gen_startup_profile.c -o src/world_gen_startup_profile.o

world-generation-profile: $(PROFILE_OBJS)
	$(CC) $(CFLAGS) -DWORLD_GEN_PROFILE -o world-generation-profile $(PROFILE_OBJS) -lm

run-world-generation-profile: world-generation-profile
	./world-generation-profile

