# Production verification: native client + headless C checks (no npm).
# Every suite here reports failures through its exit code, so `make` aborts the gate
# on the first one that fails. Only self-contained suites belong here: nothing that
# depends on pre-existing fixtures under worlds/, which is not checked in.
.PHONY: release-check-native
release-check-native: test-bulk-ops test-universe-consistency test-refactored-worlds \
                      test-home-island-shape test-world-roundtrip test-task-scheduler \
                      test-spawn-gravity test-foliage-projectiles \
                      test-movement-audit test-game-save-load \
                      test-universe-layout test-settlement test-currency test-craft test-chronicle test-nav-aide test-voxel-materials test-mob-skills \
                      test-material-worlds test-foliage-bend test-fog-volume test-mob-models test-poly-mesh test-shadow-world test-fog-of-war \
                      test-universe-biome test-fire-sim test-water-table test-volcano-storm \
                      test-storyline-playthrough \
                      entropy-test \
                      universe-entropy-simple-test universe-entropy-test \
                      test-fp-renderer test-mouse-look
	@echo "=== release-check-native: running headless C tests ==="
	./test-bulk-ops
	./test-universe-consistency
	./test-refactored-worlds
	./test-home-island-shape
	./test-world-roundtrip
	./test-task-scheduler
	./test-spawn-gravity
	./test-foliage-projectiles
	./test-movement-audit
	./test-game-save-load
	./test-universe-layout
	./test-settlement
	./test-currency
	./test-craft
	./test-chronicle
	./test-nav-aide
	./test-mob-skills
	./test-material-worlds
	./test-foliage-bend
	./test-fog-volume
	./test-mob-models
	./test-poly-mesh
	./test-shadow-world
	./test-fog-of-war
	./test-universe-biome
	./test-fire-sim
	./test-water-table
	./test-volcano-storm
	./test-storyline-playthrough
	./entropy-test
	./universe-entropy-simple-test
	./universe-entropy-test
	./test-mouse-look
	SDL_VIDEODRIVER=dummy ./test-fp-renderer
	$(MAKE) verse-client
	@echo "=== release-check-native: OK ==="

