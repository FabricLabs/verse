    "COMBAT": {
      "name": "Combat",
      "description": "Intense, fast-paced battle music",
      "tempo": 140,
      "key": "A",
      "scale": "minor",
      "instruments": {
        "Ambient Pad": {
          "active": false,
          "amplitude_multiplier": 0.0,
          "frequency_multiplier": 1.0,
          "pattern": "none"
        },
        "Rhythm Bass": {
          "active": true,
          "amplitude_multiplier": 1.0,
          "frequency_multiplier": 1.0,
          "pattern": "aggressive_bass"
        },
        "Melody Lead": {
          "active": true,
          "amplitude_multiplier": 1.0,
          "frequency_multiplier": 1.0,
          "pattern": "intense_melody"
        },
        "Harmony Voice": {
          "active": true,
          "amplitude_multiplier": 0.9,
          "frequency_multiplier": 1.0,
          "pattern": "dramatic_chords"
        },
        "Percussion": {
          "active": true,
          "amplitude_multiplier": 1.0,
          "frequency_multiplier": 1.0,
          "pattern": "intense_beat"
        }
      }
    }
  },

  "adaptive_parameters": {
    "health_based": {
      "low_health_threshold": 0.3,
      "high_health_threshold": 0.7,
      "effects": {
        "low_health": {
          "tempo_multiplier": 0.8,
          "amplitude_multiplier": 0.7,
          "frequency_shift": -0.1
        },
        "high_health": {
          "tempo_multiplier": 1.2,
          "amplitude_multiplier": 1.1,
          "frequency_shift": 0.05
        }
      }
    },
    "battle_time": {
      "short_battle_threshold": 30,
      "long_battle_threshold": 120,
      "effects": {
        "short_battle": {
          "tempo_multiplier": 1.1,
          "intensity_increase": 0.2
        },
        "long_battle": {
          "tempo_multiplier": 0.9,
          "intensity_decrease": 0.1
        }
      }
    },
    "player_level": {
      "effects": {
        "low_level": {
          "complexity_reduction": 0.3,
          "melody_simplification": true
        },
        "high_level": {
          "complexity_increase": 0.2,
          "additional_harmonies": true
        }
      }
    }
  },

  "transition_settings": {
    "crossfade_duration": 2.0,
    "smooth_transitions": true,
    "state_change_delay": 0.5
  }
}
