	$(CC) $(CFLAGS) -c test_isomorphic_renderer.c -o test_isomorphic_renderer.o

test_tutorial_system.o: test_tutorial_system.c
	$(CC) $(CFLAGS) -c test_tutorial_system.c -o test_tutorial_system.o

test_character_input.o: test_character_input.c
	$(CC) $(CFLAGS) -c test_character_input.c -o test_character_input.o

test_actor_system.o: test_actor_system.c
	$(CC) $(CFLAGS) -c test_actor_system.c -o test_actor_system.o

test_world_transition.o: test_world_transition.c
	$(CC) $(CFLAGS) -c test_world_transition.c -o test_world_transition.o

test_exit_prompt.o: test_exit_prompt.c
	$(CC) $(CFLAGS) -c test_exit_prompt.c -o test_exit_prompt.o

test_spawn_system.o: test_spawn_system.c
	$(CC) $(CFLAGS) -c test_spawn_system.c -o test_spawn_system.o

test_midi_reader.o: test_midi_reader.c
	$(CC) $(CFLAGS) -c test_midi_reader.c -o test_midi_reader.o

src/midi_reader.o: src/midi_reader.c
	$(CC) $(CFLAGS) -c src/midi_reader.c -o src/midi_reader.o

src/songwriter/songwriter.o: src/songwriter/songwriter.c
	$(CC) $(CFLAGS) -c src/songwriter/songwriter.c -o src/songwriter/songwriter.o

src/synthesizer/synthesizer.o: src/synthesizer/synthesizer.c
	$(CC) $(CFLAGS) -c src/synthesizer/synthesizer.c -o src/synthesizer/synthesizer.o

src/world_spawn.o: src/world_spawn.c
	$(CC) $(CFLAGS) -c src/world_spawn.c -o src/world_spawn.o

src/input_manager.o: src/input_manager.c
	$(CC) $(CFLAGS) -c src/input_manager.c -o src/input_manager.o

# Run all tests
test: test-tutorial-system test-character-input test-isomorphic-renderer test-level-system test-level-progression test-comprehensive-level test-melody-system test-actor-system test-world-transition test-exit-prompt test-spawn-system test-midi-reader

.PHONY: clean all proxy ui clean-ui compile-ui bundle-ui ui-test ui-standalone window-test window-demo window-interactive synthesizer-test synthesizer-demo synthesizer-audio-demo synthesizer-integration test-world-storage test-world-log test-save-system test-state-transition test-dynamic-music test-world-generation-types test-level-system test-level-progression test-comprehensive-level test-melody-system test-save-system test-fullscreen-scale test-character-save-immediate test-arrow-selection test-actor-system test-world-transition test-exit-prompt test-spawn-system test-tutorial-system test-character-input test-isomorphic-renderer test-midi-reader test

# Enhanced songwriter test
test-songwriter-enhanced: test_songwriter_enhanced.c src/songwriter/songwriter.o src/synthesizer/synthesizer.o
	$(CC) $(CFLAGS) -o test-songwriter-enhanced test_songwriter_enhanced.c src/songwriter/songwriter.o src/synthesizer/synthesizer.o $(LDFLAGS) $(SDL_LIBS)
